# Where the FastAPI backend lives. NEXT_PUBLIC_* values are inlined at build
# time, so changing this in a hosted deployment needs a redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The Google client id is NOT set here: the browser reads it from the backend's
# /api/config, so rotating it needs no frontend rebuild. Set GOOGLE_CLIENT_ID on
# the backend instead.
