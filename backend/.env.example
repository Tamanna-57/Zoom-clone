# Copy to backend/.env (or export these) to override the defaults.

# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./zoomeet.db

# Change this in any deployment — it signs the access tokens.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=10080

# The fixed code the mocked SMS/e-mail verification accepts. Sign-up still uses
# it; Google accounts skip verification because Google has proved the address.
MOCK_OTP=123456

# Google Sign-In. Create an OAuth 2.0 Web application client at
# https://console.cloud.google.com/apis/credentials, add your site to
# "Authorised JavaScript origins", and paste the client id here. Leave it unset
# and the "Continue with Google" button is simply not shown.
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WebRTC. STUN is enough on most networks; add TURN for symmetric NAT.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
